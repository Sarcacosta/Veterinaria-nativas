<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lavanda_casi_blanca"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de la Cita"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ciruela_oscura" />

        <!-- Tarjeta con la información actual -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/lavanda_suave"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvIdCita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gris_violaceo" />
                <TextView
                    android:id="@+id/tvFechaDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ciruela_oscura" />
                <TextView
                    android:id="@+id/tvHoraDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ciruela_oscura" />
                <TextView
                    android:id="@+id/tvEstadoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:textColor="@color/violeta_medio" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección Reprogramar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Reprogramar Cita"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ciruela_oscura" />

        <EditText
            android:id="@+id/etNuevaFecha"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Selecciona nueva fecha"
            android:focusable="false"
            android:clickable="true"
            android:paddingHorizontal="12dp" />

        <Spinner
            android:id="@+id/spHorasDisponiblesDetalle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/pbDetalleCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:indeterminateTint="@color/violeta_medio" />

        <!-- Botones de Acción -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModificarCita"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Guardar Cambios"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/violeta_medio"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarCita"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar Cita"
            android:textColor="@color/blanco"
            android:backgroundTint="#C62828"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Volver"
            android:textColor="@color/violeta_medio"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>
</ScrollView>