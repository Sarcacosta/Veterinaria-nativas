<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/back" style="@style/Link" android:text="‹ Volver"/>
        <TextView android:id="@+id/pet_form_title" style="@style/Title" android:text="Registrar mascota" />
        <TextView style="@style/Body" android:text="Completa el nombre y la especie. Los demás datos son opcionales." />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/sheet" android:padding="18dp" android:layout_marginTop="14dp"><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/name" android:text="Nombre"/>
<EditText android:id="@id/name" style="@style/Field" android:inputType="textCapWords" android:maxLength="100" android:hint="Ej. Milo"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/species" android:text="Especie"/>
<EditText android:id="@id/species" style="@style/Field" android:inputType="textCapWords" android:maxLength="80" android:hint="Ej. Perro"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/breed" android:text="Raza"/>
<EditText android:id="@id/breed" style="@style/Field" android:inputType="textCapWords" android:maxLength="100"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/sex" android:text="Sexo"/>
<EditText android:id="@id/sex" style="@style/Field" android:inputType="textCapWords" android:maxLength="40"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/color" android:text="Color"/>
<EditText android:id="@id/color" style="@style/Field" android:inputType="textCapWords" android:maxLength="80"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/birth" android:text="Fecha de nacimiento"/>
<EditText android:id="@id/birth" style="@style/Field" android:inputType="date" android:focusable="false" android:hint="AAAA-MM-DD"/><Button android:id="@+id/pick_date" style="@style/Secondary" android:text="Elegir fecha"/><TextView style="@style/Label" android:layout_marginTop="12dp" android:labelFor="@+id/weight" android:text="Peso en kg"/>
<EditText android:id="@id/weight" style="@style/Field" android:inputType="numberDecimal" android:hint="Ej. 4.5"/><LinearLayout android:id="@+id/owner_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView style="@style/Label" android:text="Propietario" /><Spinner android:id="@+id/owner" android:layout_width="match_parent" android:layout_height="48dp"/><Button android:id="@+id/reload" style="@style/Link" android:text="Actualizar propietarios"/></LinearLayout><LinearLayout android:id="@+id/loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:padding="8dp">
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp"/>
<TextView android:id="@+id/loading_text" style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Conectando con la clínica…"/>
</LinearLayout>
<TextView android:id="@+id/message" style="@style/Body" android:background="@drawable/notice" android:padding="13dp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:layout_marginBottom="8dp"/><Button android:id="@+id/save" style="@style/Action" android:text="Guardar mascota"/></LinearLayout>
    </LinearLayout>
</ScrollView>
