<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="22dp">
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/paw" android:importantForAccessibility="no"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="huella" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:layout_marginStart="9dp"/>
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="CLÍNICA VETERINARIA" android:letterSpacing="0.1" android:textSize="10sp" android:textColor="@color/muted"/>
</LinearLayout><TextView style="@style/Title" android:text="Tu primer paso
en Huella." /><TextView style="@style/Body" android:text="Crea tu cuenta para acceder a la clínica." android:layout_marginBottom="22dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/sheet" android:padding="20dp" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"><TextView style="@style/Label" android:text="Nombre completo" android:labelFor="@+id/name"/><EditText android:id="@id/name" style="@style/Field" android:hint="Ej. Sara Rodríguez" android:inputType="textPersonName" android:imeOptions="actionNext" android:maxLength="100" android:autofillHints="name"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"><TextView style="@style/Label" android:text="Correo electrónico" android:labelFor="@+id/email"/><EditText android:id="@id/email" style="@style/Field" android:hint="sara@correo.com" android:inputType="textEmailAddress" android:imeOptions="actionNext" android:maxLength="254" android:autofillHints="emailAddress"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"><TextView style="@style/Label" android:text="Nombre de usuario" android:labelFor="@+id/username"/><EditText android:id="@id/username" style="@style/Field" android:hint="Ej. sara.rodriguez" android:inputType="text" android:imeOptions="actionNext" android:maxLength="40" android:autofillHints="newUsername"/><TextView style="@style/Body" android:text="De 3 a 40 letras, números, puntos o guiones." android:textSize="12sp" android:layout_marginTop="5dp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"><TextView style="@style/Label" android:text="Contraseña" android:labelFor="@+id/password"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><EditText android:id="@id/password" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Crea una contraseña" android:inputType="textPassword" android:imeOptions="actionNext" android:saveEnabled="false" android:autofillHints="newPassword"/><Button android:id="@+id/show_password" style="@style/Link" android:layout_width="80dp" android:layout_marginTop="0dp" android:text="Mostrar" android:textSize="12sp" android:contentDescription="Mostrar contraseña"/></LinearLayout><TextView style="@style/Body" android:text="Mínimo 8 caracteres." android:textSize="12sp" android:layout_marginTop="5dp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"><TextView style="@style/Label" android:text="Confirmar contraseña" android:labelFor="@+id/confirm"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><EditText android:id="@id/confirm" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Repite tu contraseña" android:inputType="textPassword" android:imeOptions="actionNext" android:saveEnabled="false" android:autofillHints="newPassword"/><Button android:id="@+id/show_confirm" style="@style/Link" android:layout_width="80dp" android:layout_marginTop="0dp" android:text="Mostrar" android:textSize="12sp" android:contentDescription="Mostrar contraseña"/></LinearLayout></LinearLayout><TextView style="@style/Label" android:text="Tipo de cuenta" android:labelFor="@+id/registration_role"/>
<Spinner android:id="@id/registration_role" android:layout_width="match_parent" android:layout_height="48dp"
    android:entries="@array/registration_roles" android:background="@drawable/field" android:paddingStart="12dp"/>
<TextView android:id="@+id/registration_role_hint" style="@style/Body" android:layout_marginTop="6dp"
    android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite"/>
<LinearLayout android:id="@+id/loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:padding="8dp">
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp"/>
<TextView android:id="@+id/loading_text" style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Conectando con la clínica…"/>
</LinearLayout>
<TextView android:id="@+id/message" style="@style/Body" android:background="@drawable/notice" android:padding="13dp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:layout_marginBottom="8dp"/><Button android:id="@+id/save" style="@style/Action" android:text="Crear mi cuenta" /></LinearLayout><Button android:id="@+id/back" style="@style/Link" android:text="Ya tengo cuenta · Iniciar sesión" /></LinearLayout></ScrollView>