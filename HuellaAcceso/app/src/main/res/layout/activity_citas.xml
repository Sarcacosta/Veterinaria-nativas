<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page">
    <LinearLayout android:id="@+id/appointment_content" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
        <TextView android:id="@+id/appointment_title" style="@style/Title" />
        <ProgressBar android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp"
            android:visibility="gone" />
        <TextView android:id="@+id/message" style="@style/Body" android:visibility="gone"
            android:accessibilityLiveRegion="polite" android:padding="12dp" />
    </LinearLayout>
</ScrollView>