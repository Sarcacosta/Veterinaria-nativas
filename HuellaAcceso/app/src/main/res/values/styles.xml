<resources>
<style name="HuellaTheme" parent="android:style/Theme.Material.Light.NoActionBar">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/purple</item>
<item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/page</item>
<item name="android:navigationBarColor">@color/page</item><item name="android:windowLightNavigationBar">true</item>
<item name="android:windowActionModeOverlay">true</item>
</style>
<style name="Title"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textSize">29sp</item><item name="android:fontFamily">sans-serif-medium</item>
<item name="android:textColor">@color/ink</item><item name="android:layout_marginBottom">6dp</item></style>
<style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">3dp</item><item name="android:textColor">@color/muted</item></style>
<style name="Label" parent="Body"><item name="android:textSize">13sp</item><item name="android:textColor">@color/ink</item>
<item name="android:fontFamily">sans-serif-medium</item><item name="android:layout_marginBottom">7dp</item></style>
<style name="Field"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">52dp</item><item name="android:paddingStart">14dp</item><item name="android:paddingEnd">14dp</item>
<item name="android:background">@drawable/field</item><item name="android:singleLine">true</item>
<item name="android:textSize">16sp</item><item name="android:textColor">@color/ink</item>
<item name="android:textColorHint">#8C8195</item></style>
<style name="Action"><item name="android:layout_width">match_parent</item><item name="android:layout_height">54dp</item>
<item name="android:layout_marginTop">8dp</item><item name="android:background">@drawable/action</item>
<item name="android:stateListAnimator">@null</item><item name="android:textColor">@color/white</item>
<item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">15sp</item><item name="android:textAllCaps">false</item></style>
<style name="Secondary" parent="Action"><item name="android:background">@drawable/secondary</item>
<item name="android:textColor">@color/purple</item></style>
<style name="Link" parent="Action"><item name="android:background">?android:attr/selectableItemBackground</item>
<item name="android:textColor">@color/purple</item><item name="android:layout_height">48dp</item></style>
<style name="ClinicShortcut" parent="Secondary">
    <item name="android:layout_height">48dp</item>
    <item name="android:layout_marginTop">12dp</item>
    <item name="android:background">@drawable/home_button</item>
    <item name="android:textColor">@color/ink</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="android:elevation">2dp</item>
    <item name="android:textSize">13sp</item>
</style>
</resources>