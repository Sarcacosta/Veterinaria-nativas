{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Huella",
    "version": "1.0",
    "description": "Rutas de Huella para cuenta, perfil, estadísticas y mascotas. Ejecuta primero POST /api/login para que el navegador conserve la cookie de sesión."
  },
  "servers": [
    {
      "url": "..",
      "description": "Backend de Huella"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "Cuenta"
        ],
        "summary": "Crear una cuenta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registro"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta registrada. Veterinario requiere activación.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mensaje"
                  ],
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "El usuario ya existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Acceso"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acceso correcto. Tomcat envía la cookie JSESSIONID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/estadisticas": {
      "get": {
        "tags": [
          "Inicio"
        ],
        "summary": "Consultar las cifras de la clínica",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cantidad de registros",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Estadisticas"
                }
              }
            }
          },
          "401": {
            "description": "Sesión requerida o vencida"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Cerrar sesión",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión invalidada"
          },
          "401": {
            "description": "Sesión requerida o vencida"
          }
        }
      }
    },
    "/api/perfil": {
      "get": {
        "summary": "Consultar mi perfil",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil de la cuenta actual"
          },
          "401": {
            "description": "Sesión requerida"
          }
        }
      },
      "put": {
        "summary": "Actualizar mi nombre y correo",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil actualizado"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Sesión requerida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "email"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mascotas": {
      "get": {
        "summary": "Listar las mascotas autorizadas",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de mascotas"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Rol sin acceso"
          }
        }
      },
      "post": {
        "summary": "Registrar una mascota",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "201": {
            "description": "Mascota creada"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Rol sin permiso"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "especie"
                ],
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "especie": {
                    "type": "string"
                  },
                  "raza": {
                    "type": "string"
                  },
                  "sexo": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "fechaNacimiento": {
                    "type": "string",
                    "format": "date"
                  },
                  "pesoActual": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "propietario": {
                    "type": "object",
                    "required": [
                      "idPropietario"
                    ],
                    "properties": {
                      "idPropietario": {
                        "type": "integer",
                        "format": "int64"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Administrador y Recepción deben indicar el idPropietario dentro de propietario. Para una cuenta Propietario, el servidor obtiene la asociación desde la sesión."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sesion": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "Ejecuta el login desde esta página para obtener la cookie automáticamente."
      }
    },
    "schemas": {
      "Acceso": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        }
      },
      "Registro": {
        "type": "object",
        "required": [
          "nombre",
          "email",
          "username",
          "password"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{3,40}$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "description": "Hasta 72 bytes UTF-8."
          },
          "rol": {
            "type": "string",
            "enum": [
              "Propietario",
              "Veterinario"
            ],
            "default": "Propietario"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "required": [
          "id",
          "username",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Estadisticas": {
        "type": "object",
        "required": [
          "mascotas",
          "propietarios",
          "veterinarios"
        ],
        "properties": {
          "mascotas": {
            "type": "integer",
            "format": "int64"
          },
          "propietarios": {
            "type": "integer",
            "format": "int64"
          },
          "veterinarios": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
